{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/halloween-movies",
      "destination": "/api/halloween-page"
    }
  ],
  "functions": {
    "api/halloween-page.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
